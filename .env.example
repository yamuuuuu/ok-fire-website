# PostgreSQL runtime connection. In production use a pooled URL with verified TLS.
DATABASE_URL="postgresql://okfire:local-development-only@localhost:5432/okfire?schema=public"
# Direct database connection used only for migrations; may equal DATABASE_URL locally.
DIRECT_URL="postgresql://okfire:local-development-only@localhost:5432/okfire?schema=public"
APP_ORIGIN="https://localhost:3000"
# Secure is always enabled for sessions. Use `npm run dev -- --experimental-https`.
# Set APP_ORIGIN=https://localhost:3000 for local HTTPS login.
# Generate a unique secret: openssl rand -hex 32
AUTH_SECRET=""
# Random secret used only by the Vercel daily privacy-purge cron endpoint.
CRON_SECRET=""
# One-time seed inputs. No default password; do not set on the Vercel runtime.
SEED_ADMIN_NAME="초기 관리자"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Phase 3: dedicated PRIVATE S3-compatible Object Storage. HTTPS endpoint required outside localhost.
# Configure CORS to allow PUT, GET, HEAD from APP_ORIGIN; allow Content-Type headers.
# Keep public access disabled. Expire quarantine/ objects after 1 day.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Public inquiry consent. Set an owner-approved retention period before accepting inquiries.
PRIVACY_RETENTION_TEXT=""
PRIVACY_CONTACT_TEXT="010-7124-8119"
PRIVACY_POLICY_VERSION="2026-09-20-v2"
# Optional Google Analytics 4 measurement ID. Leave blank until a GA property is created.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
